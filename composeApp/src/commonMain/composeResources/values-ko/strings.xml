    <string name="explains_card_plain">%1$s. %2$d점이에요. 능력이 없어서 손에 넣거나 더미에 버리는 것뿐이에요.</string>
    <string name="explains_card_action">%1$s. %2$d점이에요. %3$s. %4$s</string>
    <string name="explains_setup">자기 카드 두 장을 보고 기억해 두세요 — 라운드가 시작되면 다시 뒤집혀요. 그다음부턴 전부 기억으로 진행돼요.</string>
    <string name="explains_scoring">모든 손이 공개돼요. 합이 가장 낮은 쪽이 라운드를 이기고, Vinto를 외친 사람은 나머지 중 최고의 손과 겨뤄요.</string>
    <string name="explains_toss_in">같은 숫자를 가진 사람은 누구나 던져 넣을 수 있고, 그러면 그 카드가 공짜로 손에서 빠져나가요. 숫자를 틀리면 페널티 카드를 받고, 이번 라운드엔 그 카드에 다시 던질 수 없어요.</string>
    <string name="explains_final_round">Vinto가 선언됐어요. 나머지 모두 마지막 한 턴을 연합으로 두고, 그중 최고의 손만 선언자와 겨뤄요.</string>
    <string name="explains_turn">덱에서 뽑거나, 더미 맨 위가 아직 아무도 쓰지 않은 능력 카드라면 그걸 가져오세요. 합계를 낮추는 카드는 가지고, 자기 손이 가장 낮다고 생각되면 Vinto를 외치세요.</string>

    <string name="detail_card_does">%1$s, %2$d점: %3$s</string>
    <string name="detail_king_declared">King이 %1$s를 선언했어요: %2$s</string>
    <string name="detail_tap_to_say">무엇이라 생각하는지 말하려면 카드를 탭하세요.</string>
    <string name="detail_table_talk">테이블 토크 — 연합은 맞든 틀리든 당신 말을 그대로 믿어요.</string>
    <string name="detail_right_plays">맞으면 능력이 실행되고, 틀리면 카드 한 장을 잃어요.</string>
    <string name="detail_wrong_costs">틀리면 페널티 카드를 받아요.</string>
    <string name="detail_barred_card">이 카드에서 틀려서 이번엔 참여할 수 없어요. 다음에 놓이는 카드가 새 기회예요.</string>
    <string name="detail_barred">틀렸고, 마지막 라운드에서는 그게 남은 라운드 내내 이어져요.</string>
    <string name="detail_scored_against">%1$s가 Vinto를 외쳐서, 라운드는 그 손을 기준으로 채점됐어요.</string>
    <string name="detail_deck_ran_out">덱이 떨어져서 라운드가 끝나고, 모든 손이 계산됐어요.</string>

