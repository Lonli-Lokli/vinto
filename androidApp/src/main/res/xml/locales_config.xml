<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages Vinto ships, declared to the OS (Android 13+ per-app language in Settings).

  Without this file the system offers no per-app language for Vinto, and its translations are reachable
  only through the in-app picker or by changing the whole phone. compose-resources are invisible to AGP's
  own generator, so the list is written by hand and AndroidConfigAudit holds it to the shipped
  composeResources/values-<locale>/ folders: a tag with no strings behind it offers a language that falls
  back to English. BCP-47 tags (he, id), not the legacy iw/in resource codes.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ar" />
    <locale android:name="be" />
    <locale android:name="bn" />
    <locale android:name="de" />
    <locale android:name="es" />
    <locale android:name="fr" />
    <locale android:name="he" />
    <locale android:name="hi" />
    <locale android:name="id" />
    <locale android:name="it" />
    <locale android:name="ja" />
    <locale android:name="ko" />
    <locale android:name="pl" />
    <locale android:name="pt" />
    <locale android:name="ru" />
    <locale android:name="tr" />
    <locale android:name="uk" />
    <locale android:name="ur" />
    <locale android:name="zh" />
</locale-config>
