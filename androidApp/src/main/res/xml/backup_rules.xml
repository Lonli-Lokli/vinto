<?xml version="1.0" encoding="utf-8"?>
<!--
    What survives a reinstall, for Android 12 and up (Auto Backup + device-to-device transfer).

    Everything a player produced lives in one SharedPreferences file, so the whole file is included
    and nothing else is: the table's settings and whatever a seat has kept. That file is the reason this
    exists — progress lost to a phone upgrade is the paid app failing at the one thing it is sold on.

    Excluded deliberately: nothing yet. When a device-bound value appears — a push token, a cached
    credential — it belongs in its own file and gets excluded here, because restoring one onto a
    different device is worse than losing it.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="vinto.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="vinto.xml" />
    </device-transfer>
</data-extraction-rules>
