<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The one permission this app asks for, and it was missing.

        Without it Android refuses every socket the process opens, so online play could not
        work at all *and* no crash report could ever leave the device — which is why a crash
        on the online screen was reported nowhere: the handler fired, the envelope was built,
        and the POST was denied by the platform before it reached the network. Two failures
        that look like one, from a line that was never written.

        Nothing else is asked for. There is no camera, no location, no contacts and no
        advertising id here, and `INTERNET` is a normal permission: it is granted at install
        and never prompts.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Vinto"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vinto">
        <!--
            Free to rotate. The table has a landscape arrangement of its own — the control
            rail stands beside the felt instead of under it (`TableLayout` in `CardScale.kt`)
            — so the portrait lock that used to sit here is gone. `configChanges` keeps the
            activity alive across the rotation: the layout re-decides itself inside
            `BoxWithConstraints`, and recreating the activity would cost the game's
            in-memory state for a change Compose absorbs in one recomposition.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Invitations open the app.

                Until this existed, an invite carrying a room code still asked somebody to
                *type* it: install the game, find the online screen, copy six characters
                across from a message. Every step of that is somewhere to lose them, and it
                is the step `FunnelStep.INVITE_SHARED` → `ROOM_JOINED` was built to measure.

                Two filters, because they fail in opposite ways. The https one is an **App
                Link**: `autoVerify` makes Android check
                https://vinto.kupalinka.app/.well-known/assetlinks.json for this app's signing
                fingerprint, and only then does it open the app without a chooser — and if the
                app is not installed, the same link is a real web page. That verification
                cannot succeed until the file is published against the release key, which
                needs the upload keystore (README §1f), so the custom scheme is the belt: no
                hosted file, no verification, no web fallback, and it works today between two
                people who both have the app.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="vinto.kupalinka.app"
                      android:pathPrefix="/r/" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vinto" />
            </intent-filter>
        </activity>
    </application>

</manifest>
