{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinto-room",
  "main": "index.mjs",
  "compatibility_date": "2026-08-01",

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },

  "migrations": [
    {
      // SQLite-backed classes are the only kind available on the free plan (design D9).
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
