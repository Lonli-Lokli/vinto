<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon on API 26+. Two layers the launcher masks to whatever shape the
    device prefers — circle, squircle, teardrop — which is why the mark sits well inside
    the foreground rather than filling it. Generated by `kmp/tools/make-launcher-icons.py`
    from the web app's own favicon, so the phone and the browser answer to the same V.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icons (API 33+): only the alpha is read, the launcher supplies the colour. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
