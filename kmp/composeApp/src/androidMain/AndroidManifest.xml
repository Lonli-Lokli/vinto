<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="Vinto"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vinto">
        <!--
            Portrait only. The table is a fixed four-sided arrangement sized to the height it
            is given (`CardScale.kt`), and it has two sizes to step down through, not a
            continuum; a phone in landscape has less height than the smaller of them needs.
            Android 16 ignores this on large screens, which is the
            right place for it to be ignored — a tablet has the height to spare, and the
            layout already adapts through `BoxWithConstraints`. Landscape on a phone is task
            7.6, not something to fake by leaving the app free to rotate into it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
