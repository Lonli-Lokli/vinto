<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en-GB</string>
    <!-- Every language the app speaks, which iOS cannot find for itself. Compose keeps its strings
         in compose-resources (composeApp/…/composeResources/values-<locale>/), not in .lproj
         folders, so without this list the bundle reads as English-only: the App Store lists
         English and nothing else (it reads the BUILD, not the listing), iOS Settings has no
         Language row for the app, and the phone's own language never reaches it. Reported
         2026-10-09: "Vinto has translations but they are invisible on iOS". The list is
         `Language` in Language.kt, with Chinese written as Apple wants it (zh-Hans for
         Compose's zh); `IosKnowsItsLanguagesTest` holds the two together. -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>ar</string>
        <string>be</string>
        <string>bn</string>
        <string>de</string>
        <string>es</string>
        <string>fr</string>
        <string>he</string>
        <string>hi</string>
        <string>id</string>
        <string>it</string>
        <string>ja</string>
        <string>ko</string>
        <string>pl</string>
        <string>pt</string>
        <string>ru</string>
        <string>tr</string>
        <string>uk</string>
        <string>ur</string>
        <string>zh-Hans</string>
    </array>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>Vinto!</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <!-- Both come from the project's own build settings (project.yml), so the version a person
         reads in the App Store and the version the build calls itself cannot drift apart. -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- The launch screen: the app icon's own V standing whole on the felt, as Android's does. It
         was an empty dict, which is a blank screen. Both assets are GENERATED by
         `tools/make-launch-screen.mjs` from `brand/vinto-icon.svg`, each with a dark appearance
         (the dark app icon's felt and V), so it follows the phone the way the first screen does.
         Centred on the whole screen rather than the safe area, where Android centres it too. -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchFelt</string>
        <key>UIImageName</key>
        <string>LaunchMark</string>
        <key>UIImageRespectsSafeAreaInsets</key>
        <false/>
    </dict>

    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>

    <!-- AN IPHONE IS UPRIGHT; AN IPAD TURNS EVERY WAY. The same rule Android applies from the
         screen's short side (`phoneHeldUpright` in `App.kt`, held by `PhonesStayUprightTest`).
         A phone on its side has a felt 276 points tall once the header and the room's clock are
         taken, and no arrangement of four hands, two piles and four plates fits there; a tablet's
         landscape is a real table (`TableLayout` in `CardScale.kt`), so it keeps it.

         Upside-down is iPad-only. A phone held upside down puts the earpiece at the bottom and
         is almost always an accident; a tablet has no wrong way up.

         ONE PHONE TURNS: one that folds. The closed iPhone Duo on its side keeps its whole height,
         because iOS stands its status bar in a column down the side instead of across the top,
         and Apple's own apps turn with it (owner, 2026-10-13). So the phone list names the
         landscapes too, and `Orientations` in `iOSApp.swift` — which iOS asks before this list —
         grants them only to a phone that folds and holds every other phone upright. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Required by Compose Multiplatform's PlistSanityCheck: without it the framework runs the
         UI at 60 Hz on a 120 Hz phone, and the animation layer is the thing that would show it. -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>

    <!-- INVITATIONS, the custom-scheme half.
         `vinto://7KQ2MP` is what `iOSApp.swift`'s `onOpenURL` receives, and registering it here is
         what makes that callback ever fire — the Swift was written before this file existed, so
         until now the scheme half of invitations was dead code on iOS.

         It is the belt to the Universal Link's braces. The https form is better (it opens the app
         *and* falls back to the website for somebody who has not installed it) but it cannot work
         until vinto.kupalinka.app/.well-known/apple-app-site-association is published against this
         team and bundle id. This one needs no hosted file and works today.

         The Android counterpart is the `android:scheme="vinto"` intent filter. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLName</key>
            <string>app.kupalinka.vinto.invite</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>vinto</string>
            </array>
        </dict>
    </array>

    <!-- Export compliance, answered here so App Store Connect stops asking on every upload.
         Vinto implements no cryptography of its own: the room socket, the two beacons and Sentry
         all go over the operating system's own TLS, which is exempt under the EAR. This is the
         same answer `vydanne.config.mjs` files as `export.encryption: 'exempt'`, and the two must
         agree — a `true` here with an `exempt` there is a contradiction somebody has to unpick
         mid-review. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
